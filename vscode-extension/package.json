{
  "name": "codemind-vscode",
  "displayName": "Code Mind",
  "description": "Browse and modify Code Mind mindmaps directly from VS Code",
  "version": "0.2.0",
  "publisher": "codemind",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:codeMindExplorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeMindContainer",
          "title": "Code Mind",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codeMindContainer": [
        {
          "id": "codeMindExplorer",
          "name": "Mindmaps",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeMind.refresh",
        "title": "Refresh",
        "category": "Code Mind",
        "icon": "$(refresh)"
      },
      {
        "command": "codeMind.gettingStarted",
        "title": "Getting Started",
        "category": "Code Mind",
        "icon": "$(question)"
      },
      {
        "command": "codeMind.configureApiUrl",
        "title": "Configure API URL",
        "category": "Code Mind",
        "icon": "$(plug)"
      },
      {
        "command": "codeMind.configureApiKey",
        "title": "Configure API Key",
        "category": "Code Mind",
        "icon": "$(key)"
      },
      {
        "command": "codeMind.openWebApp",
        "title": "Open Web App",
        "category": "Code Mind",
        "icon": "$(browser)"
      },
      {
        "command": "codeMind.startLocalBackend",
        "title": "Start Local Backend",
        "category": "Code Mind",
        "icon": "$(debug-start)"
      },
      {
        "command": "codeMind.stopLocalBackend",
        "title": "Stop Local Backend",
        "category": "Code Mind",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codeMind.restartLocalBackend",
        "title": "Restart Local Backend",
        "category": "Code Mind",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codeMind.showBackendLogs",
        "title": "Show Backend Logs",
        "category": "Code Mind",
        "icon": "$(output)"
      },
      {
        "command": "codeMind.createNode",
        "title": "Create Node",
        "category": "Code Mind",
        "icon": "$(add)"
      },
      {
        "command": "codeMind.renameNode",
        "title": "Rename Node",
        "category": "Code Mind",
        "icon": "$(edit)"
      },
      {
        "command": "codeMind.deleteNode",
        "title": "Delete Node",
        "category": "Code Mind",
        "icon": "$(trash)"
      },
      {
        "command": "codeMind.openNote",
        "title": "Open Note",
        "category": "Code Mind",
        "icon": "$(note)"
      },
      {
        "command": "codeMind.bindWorkspaceProject",
        "title": "Bind Mindmap to Workspace",
        "category": "Code Mind",
        "icon": "$(link)"
      },
      {
        "command": "codeMind.materializeWorkspaceProject",
        "title": "Update Workspace Project Files",
        "category": "Code Mind",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeMind.createWorkspaceSnapshot",
        "title": "Create Workspace Snapshot",
        "category": "Code Mind",
        "icon": "$(save)"
      },
      {
        "command": "codeMind.protectWorkspaceRuntime",
        "title": "Protect Workspace Runtime from Git",
        "category": "Code Mind",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeMind.refresh",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        },
        {
          "command": "codeMind.gettingStarted",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        },
        {
          "command": "codeMind.configureApiUrl",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        },
        {
          "command": "codeMind.configureApiKey",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        },
        {
          "command": "codeMind.openWebApp",
          "when": "view == codeMindExplorer",
          "group": "navigation@0"
        },
        {
          "command": "codeMind.startLocalBackend",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        },
        {
          "command": "codeMind.showBackendLogs",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        },
        {
          "command": "codeMind.materializeWorkspaceProject",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        },
        {
          "command": "codeMind.createWorkspaceSnapshot",
          "when": "view == codeMindExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codeMind.createNode",
          "when": "view == codeMindExplorer",
          "group": "inline@1"
        },
        {
          "command": "codeMind.renameNode",
          "when": "view == codeMindExplorer",
          "group": "inline@2"
        },
        {
          "command": "codeMind.deleteNode",
          "when": "view == codeMindExplorer",
          "group": "inline@3"
        },
        {
          "command": "codeMind.openNote",
          "when": "view == codeMindExplorer",
          "group": "inline@4"
        },
        {
          "command": "codeMind.bindWorkspaceProject",
          "when": "view == codeMindExplorer && viewItem == map",
          "group": "inline@5"
        }
      ]
    },
    "configuration": {
      "title": "Code Mind",
      "properties": {
        "codeMind.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:34117",
          "description": "Code Mind REST API endpoint URL"
        },
        "codeMind.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for authentication"
        },
        "codeMind.autoStartBackend": {
          "type": "boolean",
          "default": true,
          "description": "If a backend command is configured, start it automatically before opening the Web App"
        },
        "codeMind.backendCommand": {
          "type": "string",
          "default": "",
          "description": "Optional command used by VS Code to start a local Code Mind backend (e.g. \"codemind.exe serve\"). Leave empty to connect to an already-running backend"
        },
        "codeMind.backendExecutable": {
          "type": "string",
          "default": "",
          "description": "Preferred Code Mind executable path. Supports ${workspaceFolder}; when empty, VS Code searches workspace build/bin and PATH"
        },
        "codeMind.backendCwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the local backend command. Defaults to the first workspace folder"
        },
        "codeMind.dataDir": {
          "type": "string",
          "default": "",
          "description": "Optional data directory used by the extension-managed backend. Leave empty to use the shared Code Mind app data directory"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/vsce": "^3.2.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
